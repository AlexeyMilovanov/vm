+private lemma rank_sum_le_helper {α β ι : Type*} [Fintype β] (s : Finset ι)
+    (M : ι → Matrix α β ℝ) :
+    (∑ i ∈ s, M i).rank ≤ ∑ i ∈ s, (M i).rank := by
+  classical
+  induction s using Finset.induction_on with
+  | empty => simp [Matrix.rank_zero]
+  | insert a s hi ih =>
+    rw [Finset.sum_insert hi, Finset.sum_insert hi]
+    exact (rank_add_le _ _).trans (Nat.add_le_add_left ih _)
+
+private lemma rank_le_card_of_sum_vecMulVec_helper {α β ι : Type*} [Fintype β]
+    (s : Finset ι) (u : ι → α → ℝ) (v : ι → β → ℝ) :
+    (∑ i ∈ s, Matrix.vecMulVec (u i) (v i)).rank ≤ s.card :=
+  calc (∑ i ∈ s, Matrix.vecMulVec (u i) (v i)).rank
+      ≤ ∑ i ∈ s, (Matrix.vecMulVec (u i) (v i)).rank := rank_sum_le_helper s _
+    _ ≤ ∑ _i ∈ s, 1 := Finset.sum_le_sum (fun i _ => Matrix.rank_vecMulVec_le (u i) (v i))
+    _ = s.card := by simp
+
+private lemma two_mul_two_pow_sub_helper (H : ℕ) (hH : 1 ≤ H) :
+    2 * (2 ^ H - 2) + 2 = 2 ^ (H + 1) - 2 := by
+  have h2 : 2 * 2 ^ H = 2 ^ (H + 1) := by
+    rw [pow_succ', mul_comm]
+  have h3 : 2 * (2 ^ H - 2) = 2 ^ (H + 1) - 4 := by
+    rw [Nat.mul_sub_left_distrib, h2]
+  have h4 : 4 ≤ 2 ^ (H + 1) := by
+    calc 4 = 2 ^ 2 := by norm_num
+      _ ≤ 2 ^ (H + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
+  rw [h3]
+  omega
+
+private lemma cleared_score_iff_helper {H : ℕ} (τ : ℝ) (u D : Fin H → ℝ)
+    (hD : ∀ h, 0 < D h) :
+    (τ < ∑ h, u h / D h) ↔
+      0 < (∑ h, u h * ∏ h' ∈ Finset.univ.erase h, D h') - τ * ∏ h, D h := by
+  have hprod_pos : 0 < ∏ h, D h := Finset.prod_pos (fun h _ => hD h)
+  have h_sum : ∑ h, u h / D h =
+      (∑ h, u h * ∏ h' ∈ Finset.univ.erase h, D h') / ∏ h, D h := by
+    rw [Finset.sum_div]
+    congr 1
+    have hP : ∀ h, ∏ h' ∈ Finset.univ.erase h, D h' ≠ 0 :=
+      fun h => ne_of_gt (Finset.prod_pos (fun h' _ => hD h'))
+    have h_prod_eq : ∀ h, ∏ h', D h' = D h * ∏ h' ∈ Finset.univ.erase h, D h' :=
+      fun h => (Finset.mul_prod_erase Finset.univ D (Finset.mem_univ h)).symm
+    funext h
+    rw [h_prod_eq h]
+    exact (mul_div_mul_right (u h) (D h) (hP h)).symm
+  rw [h_sum]
+  have h1 : (τ < (∑ h, u h * ∏ h' ∈ Finset.univ.erase h, D h') / ∏ h, D h) ↔
+      0 < (∑ h, u h * ∏ h' ∈ Finset.univ.erase h, D h') / ∏ h, D h - τ := sub_pos.symm
+  have h2 : (0 < (∑ h, u h * ∏ h' ∈ Finset.univ.erase h, D h') / ∏ h, D h - τ) ↔
+      0 < ((∑ h, u h * ∏ h' ∈ Finset.univ.erase h, D h') - τ * ∏ h, D h) / ∏ h, D h := by
+    rw [sub_div, mul_div_cancel_right₀ _ (ne_of_gt hprod_pos)]
+  have h3 : (0 < ((∑ h, u h * ∏ h' ∈ Finset.univ.erase h, D h') - τ * ∏ h, D h) / ∏ h, D h) ↔
+      0 < (∑ h, u h * ∏ h' ∈ Finset.univ.erase h, D h') - τ * ∏ h, D h := by
+    exact div_pos_iff_of_pos_right hprod_pos
+  rw [h1, h2, h3]
