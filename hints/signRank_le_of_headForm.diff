+private lemma exists_eta_signMatches {a b : ℕ} {f : (Fin (a + b) → Bool) → Bool}
+    (Q : (Fin a → Bool) → (Fin b → Bool) → ℝ)
+    (hfQ : ∀ x y, f (blockJoin x y) = true ↔ 0 < Q x y) :
+    ∃ η : ℝ, 0 < η ∧ SignMatches (signMatrix a b f) (fun x y => Q x y - η) := by
+  classical
+  let S : Finset ℝ := (Finset.univ ×ˢ Finset.univ).filter
+    (fun p : (Fin a → Bool) × (Fin b → Bool) => f (blockJoin p.1 p.2) = true)
+      |>.image (fun p => Q p.1 p.2)
+  by_cases hS : S.Nonempty
+  · let smin := S.min' hS
+    have hsmin_mem : smin ∈ S := Finset.min'_mem S hS
+    have hsmin_pos : 0 < smin := by
+      rcases Finset.mem_image.mp hsmin_mem with ⟨p, hp_mem, hp_eq⟩
+      rcases Finset.mem_filter.mp hp_mem with ⟨_, hf_true⟩
+      rw [← hp_eq]
+      exact (hfQ p.1 p.2).mp hf_true
+    use smin / 2
+    refine ⟨by linarith, ?_⟩
+    intro x y
+    rw [signMatrix_apply]
+    by_cases hf : f (blockJoin x y) = true
+    · rw [if_pos hf]
+      have hmem : Q x y ∈ S := by
+        apply Finset.mem_image.mpr
+        refine ⟨(x, y), ?_, rfl⟩
+        exact Finset.mem_filter.mpr
+          ⟨Finset.mem_product.mpr ⟨Finset.mem_univ x, Finset.mem_univ y⟩, hf⟩
+      have hsle : smin ≤ Q x y := Finset.min'_le S (Q x y) hmem
+      have hsub : 0 < Q x y - smin / 2 := by linarith
+      linarith
+    · rw [if_neg hf]
+      have hQ_nonpos : Q x y ≤ 0 := by
+        by_contra hcont
+        have hftrue := (hfQ x y).mpr (not_le.mp hcont)
+        exact hf hftrue
+      have hsub : Q x y - smin / 2 < 0 := by linarith
+      nlinarith
+  · use 1
+    refine ⟨by norm_num, ?_⟩
+    intro x y
+    rw [signMatrix_apply]
+    by_cases hf : f (blockJoin x y) = true
+    · exfalso
+      apply hS
+      refine ⟨Q x y, ?_⟩
+      apply Finset.mem_image.mpr
+      refine ⟨(x, y), ?_, rfl⟩
+      exact Finset.mem_filter.mpr
+        ⟨Finset.mem_product.mpr ⟨Finset.mem_univ x, Finset.mem_univ y⟩, hf⟩
+    · rw [if_neg hf]
+      have hQ_nonpos : Q x y ≤ 0 := by
+        by_contra hcont
+        have hftrue := (hfQ x y).mpr (not_le.mp hcont)
+        exact hf hftrue
+      nlinarith
+
+private lemma outer_product_sum_rank_bound {a b H : ℕ} (hH : 1 ≤ H)
+    (S_int : Finset (Finset (Fin H)))
+    (hS_card : S_int.card = 2 ^ H - 2)
+    (u_b1 : (Fin a → Bool) → ℝ) (v_b1 : (Fin b → Bool) → ℝ)
+    (u_b2 : (Fin a → Bool) → ℝ) (v_b2 : (Fin b → Bool) → ℝ)
+    (u1 : Finset (Fin H) → (Fin a → Bool) → ℝ)
+    (v1 : Finset (Fin H) → (Fin b → Bool) → ℝ)
+    (u2 : Finset (Fin H) → (Fin a → Bool) → ℝ)
+    (v2 : Finset (Fin H) → (Fin b → Bool) → ℝ) :
+    (Matrix.vecMulVec u_b1 v_b1 + Matrix.vecMulVec u_b2 v_b2 +
+      ∑ T ∈ S_int, (Matrix.vecMulVec (u1 T) (v1 T) + Matrix.vecMulVec (u2 T) (v2 T))).rank
+      ≤ 2 ^ (H + 1) - 2 := by
+  have h_sum : (∑ T ∈ S_int, (Matrix.vecMulVec (u1 T) (v1 T) +
+      Matrix.vecMulVec (u2 T) (v2 T))) =
+      (∑ T ∈ S_int, Matrix.vecMulVec (u1 T) (v1 T)) +
+      (∑ T ∈ S_int, Matrix.vecMulVec (u2 T) (v2 T)) := by
+    exact Finset.sum_add_distrib
+  rw [h_sum]
+  have r1 := rank_add_le (Matrix.vecMulVec u_b1 v_b1 + Matrix.vecMulVec u_b2 v_b2)
+    ((∑ T ∈ S_int, Matrix.vecMulVec (u1 T) (v1 T)) +
+      (∑ T ∈ S_int, Matrix.vecMulVec (u2 T) (v2 T)))
+  have r2 := rank_add_le (Matrix.vecMulVec u_b1 v_b1) (Matrix.vecMulVec u_b2 v_b2)
+  have r3 := rank_add_le (∑ T ∈ S_int, Matrix.vecMulVec (u1 T) (v1 T))
+    (∑ T ∈ S_int, Matrix.vecMulVec (u2 T) (v2 T))
+  have rb1 := Matrix.rank_vecMulVec_le u_b1 v_b1
+  have rb2 := Matrix.rank_vecMulVec_le u_b2 v_b2
+  have rs1 := rank_le_card_of_sum_vecMulVec_helper S_int u1 v1
+  have rs2 := rank_le_card_of_sum_vecMulVec_helper S_int u2 v2
+  have h_sub := two_mul_two_pow_sub_helper H hH
+  omega
+
+private lemma headForm_cleared_matrix_outer_product_repr {a b H : ℕ} (τ η : ℝ)
+    (A : Fin H → (Fin a → Bool) → ℝ) (B : Fin H → (Fin b → Bool) → ℝ)
+    (A' : Fin H → (Fin a → Bool) → ℝ) (B' : Fin H → (Fin b → Bool) → ℝ) :
+    ∃ (S_int : Finset (Finset (Fin H)))
+      (hS_card : S_int.card = 2 ^ H - 2)
+      (u_b1 : (Fin a → Bool) → ℝ) (v_b1 : (Fin b → Bool) → ℝ)
+      (u_b2 : (Fin a → Bool) → ℝ) (v_b2 : (Fin b → Bool) → ℝ)
+      (u1 : Finset (Fin H) → (Fin a → Bool) → ℝ)
+      (v1 : Finset (Fin H) → (Fin b → Bool) → ℝ)
+      (u2 : Finset (Fin H) → (Fin a → Bool) → ℝ)
+      (v2 : Finset (Fin H) → (Fin b → Bool) → ℝ),
+      (fun x y => (∑ h, (A' h x + B' h y) * ∏ h' ∈ Finset.univ.erase h, (A h' x + B h' y)) -
+        τ * ∏ h, (A h x + B h y) - η) =
+      Matrix.vecMulVec u_b1 v_b1 + Matrix.vecMulVec u_b2 v_b2 +
+        ∑ T ∈ S_int, (Matrix.vecMulVec (u1 T) (v1 T) + Matrix.vecMulVec (u2 T) (v2 T)) := by
+  sorry
