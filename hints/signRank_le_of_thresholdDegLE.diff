 theorem sum_choose_le_pow (a d : ℕ) :
     ∑ i ∈ Finset.range (d + 1), a.choose i ≤ (a + 1) ^ d := by
+  induction d with
+  | zero => simp
+  | succ d ih =>
+    rw [Finset.sum_range_succ]
+    calc
+      ∑ i ∈ Finset.range (d + 1), a.choose i + a.choose (d + 1)
+        ≤ (a + 1) ^ d + a * a.choose d := by
+          gcongr
+          exact choose_le_mul_choose a d
+      _ ≤ (a + 1) ^ d + a * ∑ i ∈ Finset.range (d + 1), a.choose i := by
+          gcongr
+          exact Finset.single_le_sum (fun _ _ => Nat.zero_le _)
+            (Finset.mem_range.mpr (Nat.lt_succ_self d))
+      _ ≤ (a + 1) ^ d + a * (a + 1) ^ d := by
+          gcongr
+      _ = (a + 1) * (a + 1) ^ d := by ring
+      _ = (a + 1) ^ (d + 1) := by ring
+
