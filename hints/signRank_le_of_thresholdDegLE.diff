+theorem choose_le_mul_choose (a k : ℕ) : a.choose (k + 1) ≤ a * a.choose k := by
+  have h := Nat.choose_succ_right_eq a k
+  have h1 : a - k ≤ a := Nat.sub_le a k
+  have h2 : a.choose k * (a - k) ≤ a.choose k * a := Nat.mul_le_mul_left _ h1
+  rw [mul_comm (a.choose k) a] at h2
+  have h3 : a.choose (k + 1) * 1 ≤ a.choose (k + 1) * (k + 1) :=
+    Nat.mul_le_mul_left _ (Nat.succ_le_succ (Nat.zero_le k))
+  rw [mul_one] at h3
+  exact h3.trans (h.le.trans h2)
 
