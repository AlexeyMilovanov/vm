+private lemma exists_eta_shift_signMatches {a b : ℕ}
+    {f : (Fin (a + b) → Bool) → Bool} (P : MvPolynomial (Fin (a + b)) ℝ)
+    (hsr : SignRepresents P f) :
+    ∃ η : ℝ, 0 < η ∧
+      SignMatches (signMatrix a b f)
+        (fun x y => eval (cubePoint (blockJoin x y)) P - η) := by
+  let T := (Finset.univ : Finset (Fin (a + b) → Bool)).filter (fun z => f z = true)
+  by_cases hT : T.Nonempty
+  · have hT_img : (T.image (fun z => eval (cubePoint z) P)).Nonempty := hT.image _
+    set m := (T.image (fun z => eval (cubePoint z) P)).min' hT_img
+    have hm_pos : 0 < m := by
+      obtain ⟨z, hz_mem, hz_eq⟩ := Finset.mem_image.mp (Finset.min'_mem _ hT_img)
+      rw [Finset.mem_filter] at hz_mem
+      have hzm : m = eval (cubePoint z) P := hz_eq.symm
+      rw [hzm]
+      exact (hsr z).mpr hz_mem.2
+    refine ⟨m / 2, half_pos hm_pos, ?_⟩
+    intro x y
+    unfold signMatrix
+    by_cases hfxy : f (blockJoin x y) = true
+    · rw [if_pos hfxy, one_mul]
+      have hmem : blockJoin x y ∈ T := by
+        simp [T, hfxy]
+      have hle : m ≤ eval (cubePoint (blockJoin x y)) P :=
+        Finset.min'_le _ _ (Finset.mem_image_of_mem _ hmem)
+      linarith
+    · rw [if_neg hfxy]
+      have hnonpos : eval (cubePoint (blockJoin x y)) P ≤ 0 := by
+        by_contra hcon
+        have ht : f (blockJoin x y) = true := (hsr _).mp (not_le.mp hcon)
+        exact hfxy ht
+      linarith
+  · refine ⟨1, zero_lt_one, ?_⟩
+    intro x y
+    unfold signMatrix
+    have hfxy : f (blockJoin x y) = false := by
+      by_contra hcon
+      have ht : f (blockJoin x y) = true := Bool.of_not_eq_false hcon
+      have hmem : blockJoin x y ∈ T := by
+        simp [T, ht]
+      exact hT ⟨_, hmem⟩
+    rw [if_neg (by simp [hfxy])]
+    have hnonpos : eval (cubePoint (blockJoin x y)) P ≤ 0 := by
+      by_contra hcon
+      have ht : f (blockJoin x y) = true := (hsr _).mp (not_le.mp hcon)
+      rw [ht] at hfxy
+      contradiction
+    linarith
