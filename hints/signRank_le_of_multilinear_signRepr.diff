+private lemma card_subsets_card_le_proved (a d : ℕ) :
+    ((Finset.univ : Finset (Fin a)).powerset.filter (fun μ => μ.card ≤ d)).card
+      = ∑ i ∈ Finset.range (d + 1), a.choose i := by
+  have h_fiber : ((Finset.univ : Finset (Fin a)).powerset.filter
+        (fun μ => μ.card ≤ d))
+      = Finset.biUnion (Finset.range (d + 1))
+        (fun i => (Finset.univ : Finset (Fin a)).powersetCard i) := by
+    ext μ
+    simp only [Finset.mem_filter, Finset.mem_powerset, Finset.mem_biUnion, Finset.mem_range,
+      Finset.mem_powersetCard, Finset.subset_univ, true_and]
+    constructor
+    · intro hμ
+      exact ⟨μ.card, Nat.lt_succ_iff.mpr hμ, rfl⟩
+    · rintro ⟨i, hi, rfl⟩
+      exact Nat.le_of_lt_succ hi
+  rw [h_fiber, Finset.card_biUnion]
+  · apply Finset.sum_congr rfl
+    intro i _
+    rw [Finset.card_powersetCard, Finset.card_fin]
+  · intro i _ j _ hij
+    change Disjoint (Finset.powersetCard i Finset.univ) (Finset.powersetCard j Finset.univ)
+    rw [Finset.disjoint_left]
+    intro μ hi hj
+    rw [Finset.mem_powersetCard] at hi hj
+    exact hij (hi.2.symm.trans hj.2)
+
