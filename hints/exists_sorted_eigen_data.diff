+/-- Standalone helper lemma: sorting unsorted spectral data via `Tuple.sort` yields
+sorted spectral data while preserving orthonormality, span, positivity, determinant product,
+and the quadratic form representation (using `Equiv.sum_comp` and `Equiv.prod_comp`). -/
+private lemma sorted_eigen_data_of_unsorted {r : ℕ} (P : Matrix (Fin r) (Fin r) ℝ)
+    (e : Fin r → EuclideanSpace ℝ (Fin r)) (lam : Fin r → ℝ)
+    (he : Orthonormal ℝ e) (hspan : Submodule.span ℝ (Set.range e) = ⊤)
+    (hpos : ∀ i, 0 < lam i) (hdet : ∏ i, lam i = P.det)
+    (hquad : ∀ z : EuclideanSpace ℝ (Fin r), forsterQuad P z = ∑ i, lam i * ⟪e i, z⟫_ℝ ^ 2) :
+    ∃ (e' : Fin r → EuclideanSpace ℝ (Fin r)) (lam' : Fin r → ℝ),
+      Orthonormal ℝ e' ∧ Submodule.span ℝ (Set.range e') = ⊤ ∧
+      Monotone lam' ∧ (∀ i, 0 < lam' i) ∧ ∏ i, lam' i = P.det ∧
+      ∀ z : EuclideanSpace ℝ (Fin r),
+        forsterQuad P z = ∑ i, lam' i * ⟪e' i, z⟫_ℝ ^ 2 := by
+  let σ := Tuple.sort lam
+  use e ∘ σ, lam ∘ σ
+  refine ⟨?_, ?_, Tuple.monotone_sort lam, ?_, ?_, ?_⟩
+  · rw [orthonormal_iff_ite] at he ⊢
+    intro i j
+    dsimp
+    rw [he (σ i) (σ j)]
+    simp only [Equiv.apply_eq_iff_eq]
+  · rw [Set.range_comp]
+    have h_range : Set.range (σ : Fin r → Fin r) = Set.univ := Equiv.range_eq_univ _
+    rw [h_range, Set.image_univ]
+    exact hspan
+  · intro i
+    exact hpos (σ i)
+  · change (∏ i, lam (σ i)) = P.det
+    rw [Equiv.prod_comp σ lam]
+    exact hdet
+  · intro z
+    rw [hquad z]
+    change ∑ i, lam i * ⟪e i, z⟫_ℝ ^ 2 = ∑ i, lam (σ i) * ⟪e (σ i), z⟫_ℝ ^ 2
+    exact (Equiv.sum_comp σ (fun i => lam i * ⟪e i, z⟫_ℝ ^ 2)).symm
+
