+/-- Standalone helper lemma: transforming unit vectors via a linear equivalence `T`
+and its adjoint inverse `LinearMap.adjoint T.symm` (followed by normalization)
+strictly preserves inner product sign margins. -/
+private theorem sign_preserved_under_reposition {r : ℕ}
+    (T : EuclideanSpace ℝ (Fin r) ≃ₗ[ℝ] EuclideanSpace ℝ (Fin r))
+    (u v : EuclideanSpace ℝ (Fin r)) (s : ℝ) (hs : 0 < s * ⟪u, v⟫_ℝ) :
+    let T_adj := LinearMap.adjoint (T.symm : EuclideanSpace ℝ (Fin r) →ₗ[ℝ]
+      EuclideanSpace ℝ (Fin r))
+    0 < s * ⟪(‖T u‖)⁻¹ • T u, (‖T_adj v‖)⁻¹ • T_adj v⟫_ℝ := by
+  intro T_adj
+  have hTu : T u ≠ 0 := by
+    intro h
+    have hu0 : u = 0 := T.map_eq_zero_iff.mp h
+    rw [hu0, inner_zero_left, mul_zero] at hs
+    exact lt_irrefl 0 hs
+  have hTv : T_adj v ≠ 0 := by
+    intro h
+    have h2 : ⟪T u, T_adj v⟫_ℝ = 0 := by rw [h, inner_zero_right]
+    have h_adj : ⟪T u, T_adj v⟫_ℝ = ⟪u, v⟫_ℝ := by
+      dsimp [T_adj]
+      rw [LinearMap.adjoint_inner_right]
+      simp
+    rw [h_adj] at h2
+    rw [h2, mul_zero] at hs
+    exact lt_irrefl 0 hs
+  rw [real_inner_smul_left, real_inner_smul_right]
+  have h_adj : ⟪T u, T_adj v⟫_ℝ = ⟪u, v⟫_ℝ := by
+    dsimp [T_adj]
+    rw [LinearMap.adjoint_inner_right]
+    simp
+  rw [h_adj]
+  have hpos1 : 0 < (‖T u‖)⁻¹ := inv_pos.mpr (norm_pos_iff.mpr hTu)
+  have hpos2 : 0 < (‖T_adj v‖)⁻¹ := inv_pos.mpr (norm_pos_iff.mpr hTv)
+  have h_eq : s * ((‖T u‖)⁻¹ * ((‖T_adj v‖)⁻¹ * ⟪u, v⟫_ℝ)) =
+    ((‖T u‖)⁻¹ * (‖T_adj v‖)⁻¹) * (s * ⟪u, v⟫_ℝ) := by ring
+  rw [h_eq]
+  exact mul_pos (mul_pos hpos1 hpos2) hs
+
+/-- P5.2 (Helper step 1): unit vectors with strict sign margin can be perturbed into
+general position (every proper subspace W contains fewer than `(N/r)·dim W` vectors)
+while strictly preserving all inner product sign margins. -/
+private theorem exists_general_position_perturbation {r : ℕ} {ι : Type*} [Fintype ι]
+    (hr : 0 < r) (hcard : r < Fintype.card ι)
+    (u v : ι → EuclideanSpace ℝ (Fin r))
+    (hu : ∀ x, ‖u x‖ = 1) (hv : ∀ y, ‖v y‖ = 1)
+    (s : ι → ι → ℝ) (hs : ∀ x y, 0 < s x y * ⟪u x, v y⟫_ℝ) :
+    ∃ u₁ v₁ : ι → EuclideanSpace ℝ (Fin r),
+      (∀ x, ‖u₁ x‖ = 1) ∧ (∀ y, ‖v₁ y‖ = 1) ∧
+      (∀ x y, 0 < s x y * ⟪u₁ x, v₁ y⟫_ℝ) ∧
+      (∀ (W : Submodule ℝ (EuclideanSpace ℝ (Fin r))) (hW : Module.finrank ℝ W < r),
+        open scoped Classical in
+        ((Finset.univ.filter (fun x => u₁ x ∈ W)).card : ℝ) < ((Fintype.card ι : ℝ) / r) * Module.finrank ℝ W) := by
+  sorry
